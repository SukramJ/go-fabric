# Build output and local test artefacts. The reference daemon builds into
# bin/ (make chiptool-build); a plain `go build ./examples/reference-bridge`
# drops it at the root, which is never meant to be committed.
/bin/
/reference-bridge
*.test
*.out

# IDE project state. GoLand writes .idea/ into any directory it opens; none
# of it describes the module.
.idea/

# Output of the two on-demand reachability companions, which are run by hand
# while reading a finding. The inventory and summary next to them ARE committed
# — the ratchet test reads the inventory, and CI diffs both.
/script/reachability/crosscheck.json
/script/reachability/whitelist-audit.md

# Python bytecode from the chip conformance runner's test fixtures.
__pycache__/
*.pyc

# Claude Code agent worktrees.
/.claude/worktrees/

# a plain `go build` inside the example directory drops its binary there
examples/reference-bridge/reference-bridge

# Databases a local run of an example writes (they hold fabric and CA keys)
*.db
*.db-journal
*.db-wal
*.db-shm

# The ble-virtual job installs the matter.js packages here (npm ci).
/script/ble-virtual/node_modules/
