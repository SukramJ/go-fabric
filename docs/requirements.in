# The documentation site's build (mkdocs.yml, .github/workflows/pages.yml):
# its direct requirements. Exact versions, each released at least two weeks
# before it was pinned; bump deliberately and rebuild with
# `mkdocs build --strict`. requirements.txt is the hashed lock of the whole
# set, which pages.yml installs with --require-hashes (R2-P5-sup-07); after
# a change here, regenerate it under Python 3.13 (pages.yml's) with
#   pip-compile --generate-hashes --strip-extras --allow-unsafe \
#     --no-emit-index-url --pip-args "--uploaded-prior-to P14D" \
#     --output-file requirements.txt requirements.in
# from docs/; the cutoff keeps the transitive set two weeks old as well.
mkdocs==1.6.1
mkdocs-material==9.8.1
pymdown-extensions==13.0
